# Copia este archivo como .env y completa los valores. Nunca subas .env al repo.
# Detalle y orden de configuración: docs/fase-4-seguridad.md

# ---- Públicas (prefijo VITE_: quedan visibles en el navegador) ----
VITE_CONSENT_VERSION=v1
# Mientras se prueba el flujo, dejar en true (o sin poner esta línea) — cada sesión se
# marca como de prueba y no cuenta en el embudo real. El día del lanzamiento real,
# cambiar a false aquí Y en las variables de entorno de Vercel, y volver a desplegar.
VITE_TEST_MODE=true
VITE_WHATSAPP_NUMBER=
VITE_WHATSAPP_CHANNEL_URL=
VITE_AGENT_CHAT_ENABLED=false
VITE_TURNSTILE_SITE_KEY=
# VITE_BACKEND=off  → modo prototipo: no envía nada a /api

# ---- Solo servidor (funciones /api de Vercel; sin VITE_, nunca llegan al navegador) ----
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=sb_publishable_...
SEND_REPORT_SECRET=
LEADS_ENC_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=
ALLOWED_ORIGINS=
AGENT_URL=
GCP_SA_KEY=
