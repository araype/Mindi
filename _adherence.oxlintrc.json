{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/chat/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "ui_kits/web/**"
            ],
            "message": "Importa los componentes del paquete, no sus archivos internos."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Color en hexadecimal: usa un token de tokens/colors.css con var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Special Gothic|Signika|Space Mono|DM Mono|var\\())/i]",
        "message": "Fuente fuera del sistema. Disponibles: Special Gothic, Signika, Space Mono, DM Mono."
      }
    ]
  }
}
